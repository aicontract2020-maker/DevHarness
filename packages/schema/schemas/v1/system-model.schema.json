{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devharness.dev/schemas/v1/system-model.schema.json",
  "title": "Dynamic system, database and security model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "repository_identity", "commit_sha", "components", "stores", "entities", "trust_boundaries", "roles", "flows", "invariants", "risks", "unknowns", "verdict"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" },
    "repository_identity": { "type": "string", "minLength": 1 },
    "commit_sha": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/gitCommit" },
    "components": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "owner"], "properties": { "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "kind": { "enum": ["frontend", "backend", "database", "queue", "identity", "external", "deployment", "automation"] }, "owner": { "type": "string", "minLength": 1 } } } },
    "stores": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "disposable_test_available"], "properties": { "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "kind": { "type": "string", "minLength": 1 }, "disposable_test_available": { "type": "boolean" } } } },
    "entities": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "store_id", "owner_component_id", "classifications", "constraints", "indexes", "migration_refs"], "properties": { "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "store_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "owner_component_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "classifications": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "indexes": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "migration_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } } } } },
    "trust_boundaries": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "from_component_id", "to_component_id", "authentication", "authorization"], "properties": { "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "from_component_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "to_component_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "authentication": { "type": "string", "minLength": 1 }, "authorization": { "type": "string", "minLength": 1 } } } },
    "roles": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "permissions"], "properties": { "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "permissions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } } },
    "flows": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "trigger", "outcome", "steps"], "properties": { "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "trigger": { "type": "string", "minLength": 1 }, "outcome": { "type": "string", "minLength": 1 }, "steps": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["sequence", "component_id", "action", "reads", "writes", "calls", "evidence_refs"], "properties": { "sequence": { "type": "integer", "minimum": 1 }, "component_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "action": { "type": "string", "minLength": 1 }, "reads": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "writes": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "calls": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } } } } } } } },
    "invariants": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "entity_ids", "statement", "enforcement", "test_refs"], "properties": { "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "entity_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" } }, "statement": { "type": "string", "minLength": 1 }, "enforcement": { "type": "string", "minLength": 1 }, "test_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } } },
    "risks": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "classification", "summary", "evidence_refs"], "properties": { "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "classification": { "enum": ["goal-blocking", "relevant", "debt", "unverified", "false-positive"] }, "summary": { "type": "string", "minLength": 1 }, "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } } } } },
    "unknowns": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "verdict": { "enum": ["complete", "needs-evidence", "conflict", "blocked"] }
  }
}
