{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devharness.dev/schemas/v1/repository-understanding-baseline.schema.json",
  "title": "Revision-bound repository understanding claim ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "repository_identity", "commit_sha", "captured_at", "required_domains", "claims", "conflicts", "models", "strategy", "verdict"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" },
    "repository_identity": { "type": "string", "minLength": 1 },
    "commit_sha": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/gitCommit" },
    "captured_at": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/timestamp" },
    "required_domains": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["repository", "runtime", "frontend", "backend", "database", "security", "strategy", "testing", "deployment", "automation"] } },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "statement", "status", "severity", "source_refs", "evidence_refs", "affected_paths"],
        "properties": {
          "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" },
          "domain": { "enum": ["repository", "runtime", "frontend", "backend", "database", "security", "strategy", "testing", "deployment", "automation"] },
          "statement": { "type": "string", "minLength": 1 },
          "status": { "enum": ["detected", "documented", "code-confirmed", "test-confirmed", "runtime-observed", "conflict", "unverified", "not-covered"] },
          "severity": { "enum": ["info", "warning", "blocking"] },
          "source_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "affected_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "claim_ids", "severity", "status", "summary"],
        "properties": {
          "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" },
          "domain": { "type": "string", "minLength": 1 },
          "claim_ids": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" } },
          "severity": { "enum": ["warning", "blocking"] },
          "status": { "enum": ["open", "resolved"] },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_model_id", "database_covered", "security_covered", "feature_flows_covered"],
      "properties": {
        "system_model_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" },
        "database_covered": { "type": "boolean" },
        "security_covered": { "type": "boolean" },
        "feature_flows_covered": { "type": "boolean" }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy_id", "version", "status", "artifact_sha256"],
      "properties": {
        "strategy_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" },
        "version": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["proposed", "approved", "superseded"] },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "verdict": { "enum": ["ready", "needs-evidence", "conflict", "blocked"] }
  }
}
