{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devharness.dev/schemas/v1/research-records.schema.json",
  "title": "Bounded research and outbound request records",
  "$ref": "#/$defs/researchQuery",
  "$defs": {
    "exactHttpsUrl": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https://(?![^/?#]*@)[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:[/?][^#\\s]*)?$" },
    "usage": { "type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens", "total_tokens"], "properties": { "input_tokens": { "type": "integer", "minimum": 0, "maximum": 600000 }, "output_tokens": { "type": "integer", "minimum": 0, "maximum": 600000 }, "total_tokens": { "type": "integer", "minimum": 0, "maximum": 600000 } } },
    "researchRequestRecipe": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "adapter", "url", "origin_id", "method", "header_profile", "body", "deadline_seconds", "max_response_bytes", "recipe_sha256"],
      "properties": {
        "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "adapter": { "const": "exact-https-get-v1" }, "url": { "$ref": "#/$defs/exactHttpsUrl" }, "origin_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "method": { "const": "GET" }, "header_profile": { "const": "public-text-v1" }, "body": { "type": "null" }, "deadline_seconds": { "type": "integer", "minimum": 1, "maximum": 30 }, "max_response_bytes": { "type": "integer", "minimum": 1, "maximum": 2097152 }, "recipe_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }
      }
    },
    "researchQuery": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "operation_id", "purpose", "query", "origin_ids", "constructed_from", "requests", "max_sources", "query_sha256"],
      "properties": {
        "schema_version": { "const": 1 }, "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "operation_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "purpose": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/text1000" }, "query": { "type": "string", "minLength": 1, "maxLength": 512 }, "origin_ids": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" } }, "constructed_from": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sourceRef" } }, "requests": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/researchRequestRecipe" } }, "max_sources": { "type": "integer", "minimum": 1, "maximum": 5 }, "query_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }
      }
    },
    "networkResearchAuthorityRef": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/authorityRef", "properties": { "capability": { "const": "network-research" } } },
    "researchSource": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "operation_id", "run_id", "repository_identity", "commit_sha", "query_id", "network_authority_ref", "approved_origin", "authority_epoch", "reservation_id", "reservation_sha256", "request_receipt_id", "request_receipt_sha256", "final_url", "title", "retrieved_at", "content_sha256", "excerpt", "excerpt_sha256", "research_payload_sha256", "untrusted"],
      "properties": {
        "schema_version": { "const": 1 }, "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "operation_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "run_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "repository_identity": { "type": "string", "minLength": 1, "maxLength": 2048 }, "commit_sha": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/gitCommit" }, "query_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "network_authority_ref": { "$ref": "#/$defs/networkResearchAuthorityRef" }, "approved_origin": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/exactHttpsOrigin" }, "authority_epoch": { "type": "integer", "minimum": 1, "maximum": 20 }, "reservation_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "reservation_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }, "request_receipt_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "request_receipt_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }, "final_url": { "$ref": "#/$defs/exactHttpsUrl" }, "title": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/text500" }, "retrieved_at": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/timestamp" }, "content_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }, "excerpt": { "type": "string", "minLength": 1, "maxLength": 8192 }, "excerpt_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }, "research_payload_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }, "untrusted": { "const": true }
      }
    },
    "researchGatewayContext": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "operation_id", "query_id", "recipe_sha256", "authority_epoch", "authority", "subject_sha256", "remaining_requests", "remaining_bytes"],
      "properties": { "schema_version": { "const": 1 }, "operation_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "query_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "recipe_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }, "authority_epoch": { "type": "integer", "minimum": 1, "maximum": 20 }, "authority": { "$ref": "#/$defs/networkResearchAuthorityRef" }, "subject_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }, "remaining_requests": { "type": "integer", "minimum": 1, "maximum": 25 }, "remaining_bytes": { "type": "integer", "minimum": 1, "maximum": 10485760 } }
    },
    "outboundRequestReservation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "operation_id", "channel", "ordinal", "attempt_id", "query_id", "authority_capability", "authority_receipt_sha256", "authority_epoch", "request_sha256", "recipe_sha256", "reserved_input_tokens", "reserved_output_tokens", "reserved_tokens", "reserved_response_bytes", "reserved_active_ms", "reserved_at"],
      "properties": { "schema_version": { "const": 1 }, "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "operation_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "channel": { "enum": ["provider", "research"] }, "ordinal": { "type": "integer", "minimum": 1, "maximum": 120 }, "attempt_id": { "type": ["string", "null"], "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" }, "query_id": { "type": ["string", "null"], "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" }, "authority_capability": { "enum": ["agent-runtime", "network-research"] }, "authority_receipt_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }, "authority_epoch": { "type": "integer", "minimum": 0, "maximum": 20 }, "request_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }, "recipe_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }, "reserved_input_tokens": { "type": "integer", "minimum": 0, "maximum": 600000 }, "reserved_output_tokens": { "type": "integer", "minimum": 0, "maximum": 600000 }, "reserved_tokens": { "type": "integer", "minimum": 0, "maximum": 600000 }, "reserved_response_bytes": { "type": "integer", "minimum": 0, "maximum": 2097152 }, "reserved_active_ms": { "type": "integer", "minimum": 0, "maximum": 30000 }, "reserved_at": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/timestamp" } },
      "oneOf": [
        { "properties": { "channel": { "const": "provider" }, "attempt_id": { "type": "string" }, "query_id": { "type": "null" }, "authority_capability": { "const": "agent-runtime" }, "authority_epoch": { "const": 0 }, "recipe_sha256": { "type": "null" }, "reserved_tokens": { "type": "integer", "minimum": 1 }, "reserved_response_bytes": { "const": 0 }, "reserved_active_ms": { "const": 0 } } },
        { "properties": { "channel": { "const": "research" }, "attempt_id": { "type": "null" }, "query_id": { "type": "string" }, "authority_capability": { "const": "network-research" }, "authority_epoch": { "type": "integer", "minimum": 1, "maximum": 20 }, "recipe_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "reserved_input_tokens": { "const": 0 }, "reserved_output_tokens": { "const": 0 }, "reserved_tokens": { "const": 0 }, "reserved_response_bytes": { "type": "integer", "minimum": 1 }, "reserved_active_ms": { "type": "integer", "minimum": 1 }, "ordinal": { "type": "integer", "maximum": 25 } } }
      ]
    },
    "outboundRequestReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "reservation_id", "reservation_sha256", "status", "completed_at", "response_status", "response_bytes", "active_ms", "response_sha256", "final_url", "research_payload_sha256", "usage", "diagnostic_code"],
      "properties": { "schema_version": { "const": 1 }, "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "reservation_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "reservation_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }, "status": { "enum": ["completed", "failed", "interrupted", "outcome-unknown"] }, "completed_at": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/timestamp" }, "response_status": { "type": ["integer", "null"], "minimum": 0, "maximum": 599 }, "response_bytes": { "type": "integer", "minimum": 0, "maximum": 2097152 }, "active_ms": { "type": "integer", "minimum": 0, "maximum": 120000 }, "response_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }, "final_url": { "oneOf": [{ "$ref": "#/$defs/exactHttpsUrl" }, { "type": "null" }] }, "research_payload_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }, "usage": { "oneOf": [{ "$ref": "#/$defs/usage" }, { "type": "null" }] }, "diagnostic_code": { "oneOf": [{ "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/stableErrorCode" }, { "type": "null" }] } },
      "allOf": [{ "if": { "properties": { "status": { "const": "completed" } } }, "then": { "properties": { "response_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "diagnostic_code": { "type": "null" } }, "oneOf": [
        { "properties": { "final_url": { "$ref": "#/$defs/exactHttpsUrl" }, "research_payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "usage": { "type": "null" } } },
        { "properties": { "final_url": { "type": "null" }, "research_payload_sha256": { "type": "null" }, "usage": { "$ref": "#/$defs/usage" } } }
      ] } }]
    },
    "researchResultManifest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "operation_id", "reservation_id", "reservation_sha256", "outcome", "receipt_sha256", "source_sha256", "gap_sha256", "research_payload_sha256", "created_at"],
      "properties": { "schema_version": { "const": 1 }, "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "operation_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "reservation_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "reservation_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }, "outcome": { "enum": ["success", "failure"] }, "receipt_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }, "source_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }, "gap_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }, "research_payload_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }, "created_at": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/timestamp" } },
      "oneOf": [{ "properties": { "outcome": { "const": "success" }, "source_sha256": { "type": "string" }, "gap_sha256": { "type": "null" }, "research_payload_sha256": { "type": "string" } } }, { "properties": { "outcome": { "const": "failure" }, "source_sha256": { "type": "null" }, "gap_sha256": { "type": "string" }, "research_payload_sha256": { "type": "null" } } }]
    },
    "researchOriginCandidate": {
      "type": "object", "additionalProperties": false, "required": ["id", "origin", "source", "source_sha256"],
      "properties": { "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "origin": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/exactHttpsOrigin" }, "source": { "enum": ["developer-input", "signed-runtime-registry", "agent-suggestion"] }, "source_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" } }
    },
    "agentRuntimeSubject": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "repository_identity", "commit_sha", "descriptor_sha256", "implementation_sha256", "executable_sha256", "profile_template_sha256", "profile_id", "model_id", "control_plane_origins", "phases", "max_attempts_per_phase", "max_agent_attempts", "max_provider_requests", "provider_request_deadline_seconds", "max_active_execution_seconds", "max_total_tokens", "consumer_write", "reversibility"],
      "properties": { "schema_version": { "const": 1 }, "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "repository_identity": { "type": "string", "minLength": 1, "maxLength": 2048 }, "commit_sha": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/gitCommit" }, "descriptor_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }, "implementation_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }, "executable_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }, "profile_template_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }, "profile_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "model_id": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/text256" }, "control_plane_origins": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/exactHttpsOrigin" } }, "phases": { "type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{ "const": "analysis-plan" }, { "const": "analysis-synthesis" }, { "const": "analysis-validation" }], "items": false }, "max_attempts_per_phase": { "const": 2 }, "max_agent_attempts": { "const": 6 }, "max_provider_requests": { "const": 120 }, "provider_request_deadline_seconds": { "const": 120 }, "max_active_execution_seconds": { "type": "integer", "minimum": 60, "maximum": 3600 }, "max_total_tokens": { "type": "integer", "minimum": 1, "maximum": 600000 }, "consumer_write": { "const": false }, "reversibility": { "const": "revocable-before-next-external-action" } }
    },
    "networkResearchSubject": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "operation_id", "query_set_sha256", "queries", "origins", "max_queries", "max_sources_per_query", "max_requests", "max_redirects_per_request", "max_response_bytes", "max_total_bytes", "request_deadline_seconds", "reversibility"],
      "properties": { "schema_version": { "const": 1 }, "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "operation_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "query_set_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }, "queries": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/artifactRef" } }, "origins": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/researchOriginCandidate" } }, "max_queries": { "type": "integer", "minimum": 1, "maximum": 5 }, "max_sources_per_query": { "type": "integer", "minimum": 1, "maximum": 5 }, "max_requests": { "type": "integer", "minimum": 1, "maximum": 25 }, "max_redirects_per_request": { "type": "integer", "minimum": 0, "maximum": 3 }, "max_response_bytes": { "type": "integer", "minimum": 1, "maximum": 2097152 }, "max_total_bytes": { "type": "integer", "minimum": 1, "maximum": 10485760 }, "request_deadline_seconds": { "type": "integer", "minimum": 1, "maximum": 30 }, "reversibility": { "const": "revocable-before-next-request" } }
    }
  }
}
