{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devharness.dev/schemas/v1/project-config.schema.json",
  "title": "Tracked consumer configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "platforms", "quality", "autonomy", "delivery"],
  "$defs": {
    "httpReadinessCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "expected_statuses", "timeout_ms", "interval_ms"],
      "properties": {
        "kind": { "enum": ["http", "tcp"] },
        "url": { "type": "string", "format": "uri" },
        "expected_statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 100, "maximum": 599 }
        },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 1800000 },
        "interval_ms": { "type": "integer", "minimum": 100, "maximum": 5000 }
      }
    }
  },
  "properties": {
    "version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier"
        }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["web", "api", "cli", "library", "mobile", "desktop", "unknown"]
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "run", "source"],
            "properties": {
              "id": {
                "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier"
              },
              "kind": {
                "enum": ["build", "test", "lint", "typecheck", "launch", "verify"]
              },
              "run": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "env_keys": {
                "type": "array",
                "description": "Host environment keys this command may receive during isolated verify execution.",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              }
            }
          }
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["services", "verifications"],
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "command_id", "readiness", "shutdown"],
            "properties": {
              "id": {
                "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier"
              },
              "command_id": {
                "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier"
              },
              "readiness": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "url", "expected_statuses", "timeout_ms", "interval_ms"],
                "properties": {
                  "kind": { "enum": ["http", "tcp"] },
                  "url": { "type": "string", "format": "uri" },
                  "expected_statuses": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "integer", "minimum": 100, "maximum": 599 }
                  },
                  "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 1800000 },
                  "interval_ms": { "type": "integer", "minimum": 100, "maximum": 5000 },
                  "additional_checks": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/httpReadinessCheck" }
                  }
                }
              },
              "shutdown": {
                "type": "object",
                "additionalProperties": false,
                "required": ["grace_ms"],
                "properties": {
                  "grace_ms": { "type": "integer", "minimum": 100, "maximum": 30000 },
                  "run": { "type": "string", "minLength": 1 },
                  "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 }
                }
              }
            }
          }
        },
        "verifications": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command_id", "service_ids"],
            "properties": {
              "command_id": {
                "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier"
              },
              "service_ids": {
                "type": "array",
                "maxItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier"
                }
              },
              "warmup": {
                "type": "array",
                "maxItems": 20,
                "items": { "$ref": "#/$defs/httpReadinessCheck" }
              }
            }
          }
        }
      }
    },
    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_gates"],
      "properties": {
        "required_gates": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["scope", "delivery"]
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "target"],
      "properties": {
        "provider": {
          "enum": ["github", "manual"]
        },
        "target": {
          "const": "pull-request"
        }
      }
    }
  }
}
