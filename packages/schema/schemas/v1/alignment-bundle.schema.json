{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devharness.dev/schemas/v1/alignment-bundle.schema.json",
  "title": "Deterministic and reviewable goal alignment bundle",
  "$ref": "#/$defs/alignmentBundle",
  "$defs": {
    "goalRef": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/artifactRef", "properties": { "kind": { "const": "goal" } } },
    "developerAnswerRef": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/artifactRef", "properties": { "kind": { "const": "developer-answer" } } },
    "analysisPlanRef": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/artifactRef", "properties": { "kind": { "const": "analysis-plan" } } },
    "researchSourceRef": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/artifactRef", "properties": { "kind": { "const": "research-source" } } },
    "goalAnalysisRef": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/artifactRef", "properties": { "kind": { "const": "goal-analysis" } } },
    "validationRef": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/artifactRef", "properties": { "kind": { "const": "analysis-validation" } } },
    "traceabilityMapping": {
      "type": "object", "additionalProperties": false, "required": ["item_id", "item_kind", "source_refs"],
      "properties": { "item_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "item_kind": { "enum": ["section-item", "decision", "criterion", "non-goal", "claim", "area", "blocker"] }, "source_refs": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sourceRefs" } }
    },
    "areaDecision": {
      "type": "object", "additionalProperties": false, "required": ["id", "area", "status", "summary", "claim_ids", "source_refs"],
      "properties": { "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "area": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/systemArea" }, "status": { "enum": ["applicable", "not-applicable", "conflict", "gap"] }, "summary": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/text2000" }, "claim_ids": { "type": "array", "minItems": 0, "maxItems": 50, "uniqueItems": true, "items": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" } }, "source_refs": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sourceRefs" } }
    },
    "classifiedClaim": {
      "type": "object", "additionalProperties": false, "required": ["id", "area", "text", "status", "source_refs", "validator_check_ids"],
      "properties": { "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "area": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/systemArea" }, "text": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/text2000" }, "status": { "enum": ["detected", "documented", "code-confirmed", "test-confirmed", "runtime-observed", "conflict", "unverified", "not-covered"] }, "source_refs": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sourceRefs" }, "validator_check_ids": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" } } }
    },
    "materialDecision": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "question", "why_now", "impact", "reversibility", "recommended_option_id", "options", "material_dimensions", "source_refs"],
      "properties": { "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "question": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/text2000" }, "why_now": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/text1000" }, "impact": { "enum": ["medium", "high"] }, "reversibility": { "enum": ["reversible", "costly", "irreversible"] }, "recommended_option_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "options": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/decisionOption" } }, "material_dimensions": { "type": "array", "minItems": 1, "maxItems": 11, "uniqueItems": true, "items": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/materialDimension" } }, "source_refs": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sourceRefs" } }
    },
    "alignmentBundle": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "operation_id", "run_id", "repository_identity", "commit_sha", "goal_ref", "developer_answer_refs", "agent_descriptor", "analysis_plan_ref", "research_source_refs", "research_gaps", "goal_analysis_ref", "validation_ref", "refined_outcome", "boundaries", "area_decisions", "classified_claims", "assumptions", "conflicts", "non_goals", "material_decisions", "acceptance_criteria", "traceability", "blocking_ids", "omitted_count", "verdict", "policy_version_sha256"],
      "properties": {
        "schema_version": { "const": 1 }, "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "operation_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "run_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "repository_identity": { "type": "string", "minLength": 1, "maxLength": 2048 }, "commit_sha": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/gitCommit" },
        "goal_ref": { "$ref": "#/$defs/goalRef" }, "developer_answer_refs": { "type": "array", "minItems": 0, "maxItems": 20, "items": { "$ref": "#/$defs/developerAnswerRef" } }, "agent_descriptor": { "$ref": "https://devharness.dev/schemas/v1/agent-runtime.schema.json#/$defs/agentDescriptor" }, "analysis_plan_ref": { "$ref": "#/$defs/analysisPlanRef" }, "research_source_refs": { "type": "array", "minItems": 0, "maxItems": 20, "items": { "$ref": "#/$defs/researchSourceRef" } }, "research_gaps": { "type": "array", "minItems": 0, "maxItems": 50, "items": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/researchGap" } }, "goal_analysis_ref": { "$ref": "#/$defs/goalAnalysisRef" }, "validation_ref": { "$ref": "#/$defs/validationRef" },
        "refined_outcome": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/reviewItem" }, "boundaries": { "type": "array", "minItems": 0, "maxItems": 50, "items": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/reviewItem" } }, "area_decisions": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "$ref": "#/$defs/areaDecision" } }, "classified_claims": { "type": "array", "minItems": 0, "maxItems": 100, "items": { "$ref": "#/$defs/classifiedClaim" } }, "assumptions": { "type": "array", "minItems": 0, "maxItems": 50, "items": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/finding" } }, "conflicts": { "type": "array", "minItems": 0, "maxItems": 50, "items": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/finding" } }, "non_goals": { "type": "array", "minItems": 0, "maxItems": 50, "items": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/reviewItem" } }, "material_decisions": { "type": "array", "minItems": 0, "maxItems": 20, "items": { "$ref": "#/$defs/materialDecision" } }, "acceptance_criteria": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/criterionProposal" } }, "traceability": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/traceabilityMapping" } }, "blocking_ids": { "type": "array", "minItems": 0, "maxItems": 100, "uniqueItems": true, "items": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" } }, "omitted_count": { "type": "integer", "minimum": 0, "maximum": 100 }, "verdict": { "enum": ["question-blocked", "ready"] }, "policy_version_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }
      },
      "oneOf": [
        { "properties": { "verdict": { "const": "ready" }, "material_decisions": { "type": "array", "maxItems": 0 }, "blocking_ids": { "type": "array", "maxItems": 0 }, "omitted_count": { "const": 0 } } },
        { "properties": { "verdict": { "const": "question-blocked" }, "material_decisions": { "type": "array", "minItems": 1 }, "blocking_ids": { "type": "array", "minItems": 1 } } }
      ]
    }
  }
}
