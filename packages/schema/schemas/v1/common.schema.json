{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devharness.dev/schemas/v1/common.schema.json",
  "title": "DevHarness common definitions",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": ["human", "agent", "tool", "runtime"]
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "approvalSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "artifact_sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer_id", "issuer_fingerprint", "payload_sha256", "algorithm", "signature"],
      "properties": {
        "issuer_id": { "$ref": "#/$defs/identifier" },
        "issuer_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "algorithm": { "const": "Ed25519" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["pending", "approved", "rejected"]
        },
        "decided_at": {
          "$ref": "#/$defs/timestamp"
        },
        "decided_by": {
          "$ref": "#/$defs/actor"
        },
        "artifact_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "capabilityRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability", "operation", "target", "scope", "reason", "risk", "authority", "decision"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "capability": { "enum": ["dependency-install", "network-research", "process-execution", "container-runtime", "browser-runtime", "simulator-runtime", "database-runtime", "credential-reference", "vcs-write", "deployment", "destructive-action"] },
        "operation": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "reason": { "type": "string", "minLength": 1 },
        "risk": { "enum": ["low", "medium", "high"] },
        "authority": { "enum": ["none", "explicit", "human-only"] },
        "decision": { "enum": ["pending", "approved", "denied", "not-needed"] }
      }
    }
  }
}
