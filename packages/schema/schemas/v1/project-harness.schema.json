{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devharness.dev/schemas/v1/project-harness.schema.json",
  "title": "Compiled revision-bound project harness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "repository_identity",
    "commit_sha",
    "config_sha256",
    "packs",
    "commands",
    "services",
    "verifications",
    "blockers"
  ],
  "$defs": {
    "resolvedCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "run", "source", "sha256"],
      "properties": {
        "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" },
        "kind": { "enum": ["build", "test", "lint", "typecheck", "launch", "verify"] },
        "run": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "env_keys": { "type": "array", "description": "Host environment keys this command may receive during isolated verify execution.", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "expected_statuses", "timeout_ms", "interval_ms"],
      "properties": {
        "kind": { "const": "http" },
        "url": { "type": "string", "format": "uri" },
        "expected_statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 100, "maximum": 599 }
        },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 1800000 },
        "interval_ms": { "type": "integer", "minimum": 100, "maximum": 5000 },
        "additional_checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/readinessCheck" }
        }
      }
    },
    "readinessCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "expected_statuses", "timeout_ms", "interval_ms"],
      "properties": {
        "kind": { "const": "http" },
        "url": { "type": "string", "format": "uri" },
        "expected_statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 100, "maximum": 599 }
        },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 1800000 },
        "interval_ms": { "type": "integer", "minimum": 100, "maximum": 5000 }
      }
    }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" },
    "repository_identity": { "type": "string", "minLength": 1 },
    "commit_sha": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/gitCommit" },
    "config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "packs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["web", "api", "cli", "library", "mobile", "desktop", "unknown"] }
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/resolvedCommand" }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "readiness", "shutdown", "sha256"],
        "properties": {
          "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" },
          "command": { "$ref": "#/$defs/resolvedCommand" },
          "readiness": { "$ref": "#/$defs/readiness" },
          "shutdown": {
            "type": "object",
            "additionalProperties": false,
            "required": ["grace_ms"],
            "properties": {
              "grace_ms": { "type": "integer", "minimum": 100, "maximum": 30000 },
              "run": { "type": "string", "minLength": 1 },
              "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 }
            }
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "verifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "service_ids", "warmup", "sha256"],
        "properties": {
          "command": { "$ref": "#/$defs/resolvedCommand" },
          "service_ids": {
            "type": "array",
            "maxItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }
          },
          "warmup": {
            "type": "array",
            "maxItems": 20,
            "items": { "$ref": "#/$defs/readinessCheck" }
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "subject", "summary"],
        "properties": {
          "code": { "enum": ["service-lifecycle-unconfigured", "behavior-verification-unconfigured", "interactive-verification-unbound"] },
          "subject": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
