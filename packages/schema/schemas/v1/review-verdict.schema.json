{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devharness.dev/schemas/v1/review-verdict.schema.json",
  "title": "Independent review verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "run_id",
    "reviewer",
    "head_sha",
    "status",
    "finding_refs",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier"
    },
    "reviewer": {
      "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/actor"
    },
    "head_sha": {
      "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/gitCommit"
    },
    "status": {
      "enum": ["pass", "fail", "blocked"]
    },
    "finding_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier"
      }
    },
    "summary": {
      "type": "string"
    },
    "completed_at": {
      "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/timestamp"
    }
  }
}

