{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devharness.dev/schemas/v1/execution-plan.schema.json",
  "title": "Safe parallel execution graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "run_id", "head_sha", "max_parallelism", "integration_owner_task_id", "progress_interval_seconds", "nodes"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" },
    "run_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" },
    "head_sha": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/gitCommit" },
    "max_parallelism": { "type": "integer", "minimum": 1 },
    "integration_owner_task_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" },
    "progress_interval_seconds": { "type": "integer", "exclusiveMinimum": 0 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "depends_on", "expected_duration_seconds", "resources", "workspace_id", "proof_criterion_ids", "long_running"],
        "properties": {
          "task_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" },
          "depends_on": { "type": "array", "uniqueItems": true, "items": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" } },
          "expected_duration_seconds": { "type": "integer", "exclusiveMinimum": 0 },
          "resources": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["kind", "id", "mode"], "properties": { "kind": { "enum": ["path", "data", "schema", "database", "service", "port", "workspace", "environment", "external"] }, "id": { "type": "string", "minLength": 1 }, "mode": { "enum": ["shared", "exclusive"] } } } },
          "workspace_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" },
          "proof_criterion_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" } },
          "long_running": { "type": "boolean" }
        }
      }
    }
  }
}
