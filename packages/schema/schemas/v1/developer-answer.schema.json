{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devharness.dev/schemas/v1/developer-answer.schema.json",
  "title": "Supervisor-verified developer alignment answer",
  "$ref": "#/$defs/developerAnswer",
  "$defs": {
    "humanActor": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/actor", "properties": { "kind": { "const": "human" } } },
    "humanDecisionRef": {
      "type": "object", "additionalProperties": false,
      "required": ["gate", "subject_sha256", "request_id", "receipt_id", "request_sha256", "receipt_sha256", "actor", "decided_at"],
      "properties": { "gate": { "const": "alignment-answer" }, "subject_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }, "request_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "receipt_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "request_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }, "receipt_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }, "actor": { "$ref": "#/$defs/humanActor" }, "decided_at": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/timestamp" } }
    },
    "developerAnswer": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "run_id", "repository_identity", "commit_sha", "packet_sha256", "decision_id", "option_id", "decision_ref", "actor", "answered_at"],
      "properties": { "schema_version": { "const": 1 }, "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "run_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "repository_identity": { "type": "string", "minLength": 1, "maxLength": 2048 }, "commit_sha": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/gitCommit" }, "packet_sha256": { "$ref": "https://devharness.dev/schemas/v1/live-alignment-common.schema.json#/$defs/sha256" }, "decision_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "option_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "decision_ref": { "$ref": "#/$defs/humanDecisionRef" }, "actor": { "$ref": "#/$defs/humanActor" }, "answered_at": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/timestamp" } }
    }
  }
}
