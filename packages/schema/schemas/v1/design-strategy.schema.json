{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devharness.dev/schemas/v1/design-strategy.schema.json",
  "title": "Developer-approved design and architecture strategy baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "repository_identity", "commit_sha", "strategy_version", "status", "artifact_sha256", "frontend", "backend", "data", "security", "testing", "decisions", "exceptions"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" },
    "repository_identity": { "type": "string", "minLength": 1 },
    "commit_sha": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/gitCommit" },
    "strategy_version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["proposed", "approved", "superseded"] },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "frontend": { "$ref": "#/$defs/strategyArea" },
    "backend": { "$ref": "#/$defs/strategyArea" },
    "data": { "$ref": "#/$defs/strategyArea" },
    "security": { "$ref": "#/$defs/strategyArea" },
    "testing": { "$ref": "#/$defs/strategyArea" },
    "decisions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/decision" } },
    "exceptions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "decision_id", "scope", "reason", "status"], "properties": { "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "decision_id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "reason": { "type": "string", "minLength": 1 }, "status": { "enum": ["proposed", "approved", "rejected"] } } } }
  },
  "$defs": {
    "strategyArea": { "type": "object", "additionalProperties": false, "required": ["principles", "enforcement"], "properties": { "principles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "enforcement": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } },
    "decision": { "type": "object", "additionalProperties": false, "required": ["id", "rule", "rationale", "applies_to", "source_refs", "enforcement"], "properties": { "id": { "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier" }, "rule": { "type": "string", "minLength": 1 }, "rationale": { "type": "string", "minLength": 1 }, "applies_to": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "enforcement": { "type": "string", "minLength": 1 } } }
  }
}
