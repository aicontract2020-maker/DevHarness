{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devharness.dev/schemas/v1/interaction-packet.schema.json",
  "title": "Decision-light developer interaction packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "run_id",
    "kind",
    "generated_at",
    "head_sha",
    "title",
    "verdict",
    "summary",
    "attention",
    "sections",
    "decisions",
    "actions",
    "source_artifacts",
    "traceability",
    "compression"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier"
    },
    "kind": {
      "enum": ["alignment-brief", "decision-queue", "progress-pulse", "delivery-brief"]
    },
    "generated_at": {
      "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/timestamp"
    },
    "head_sha": {
      "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/gitCommit"
    },
    "title": { "type": "string", "minLength": 1 },
    "verdict": {
      "enum": ["informational", "action-required", "ready", "blocked", "failed"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "attention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "count", "reasons"],
      "properties": {
        "required": { "type": "boolean" },
        "count": { "type": "integer", "minimum": 0 },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "gate-approval",
              "goal-ambiguity",
              "scope-change",
              "security-or-privacy",
              "destructive-or-irreversible",
              "financial-or-external-authority",
              "verification-blocker",
              "budget-exhausted"
            ]
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "items"],
        "properties": {
          "id": {
            "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier"
          },
          "title": { "type": "string", "minLength": 1 },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text", "confidence", "severity", "source_refs"],
              "properties": {
                "id": {
                  "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier"
                },
                "text": { "type": "string", "minLength": 1 },
                "confidence": { "enum": ["confirmed", "verify"] },
                "severity": { "enum": ["info", "warning", "blocking"] },
                "basis": {
                  "type": "array",
                  "maxItems": 10,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1, "maxLength": 128 }
                },
                "metrics": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["known_claims", "total_claims", "unknown_claims", "conflict_claims"],
                  "properties": {
                    "known_claims": { "type": "integer", "minimum": 0 },
                    "total_claims": { "type": "integer", "minimum": 0 },
                    "unknown_claims": { "type": "integer", "minimum": 0 },
                    "conflict_claims": { "type": "integer", "minimum": 0 }
                  }
                },
                "source_refs": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier"
                  }
                }
              }
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "why_now",
          "impact",
          "reversibility",
          "recommended_option_id",
          "options"
        ],
        "properties": {
          "id": {
            "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier"
          },
          "question": { "type": "string", "minLength": 1 },
          "why_now": { "type": "string", "minLength": 1 },
          "impact": { "enum": ["medium", "high"] },
          "reversibility": { "enum": ["reversible", "costly", "irreversible"] },
          "recommended_option_id": {
            "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "outcome", "tradeoffs"],
              "properties": {
                "id": {
                  "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier"
                },
                "label": { "type": "string", "minLength": 1 },
                "outcome": { "type": "string", "minLength": 1 },
                "tradeoffs": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "kind", "recommended"],
        "properties": {
          "id": {
            "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier"
          },
          "label": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["approve", "request-changes", "answer", "inspect", "cancel"]
          },
          "recommended": { "type": "boolean" }
        }
      }
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "sha256"],
        "properties": {
          "id": {
            "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier"
          },
          "kind": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "uri": { "type": "string", "format": "uri-reference" }
        }
      }
    },
    "traceability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "source_refs"],
        "properties": {
          "item_id": {
            "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier"
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "https://devharness.dev/schemas/v1/common.schema.json#/$defs/identifier"
            }
          }
        }
      }
    },
    "compression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_artifact_count", "surfaced_item_count", "omitted_item_count"],
      "properties": {
        "source_artifact_count": { "type": "integer", "minimum": 1 },
        "surfaced_item_count": { "type": "integer", "minimum": 1 },
        "omitted_item_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
